{
  "description": "修正案の盤面の控え（plan-fields.json。書き手は修正案の block の受け付け〔lib/planmarks.py の save〕）{round, fields: [項目ごとの works の欄], amended?: {番号: 核の欄}}。欄の行の型の住処は lib/planmarks.py の FIELD_SCHEMA・FILES_SCHEMA（受け付けが照らす）で、ここは読み手が読む欄の型だけを書く",
  "type": "object",
  "required": [
    "round",
    "fields"
  ],
  "properties": {
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit_keys": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "integer"
              ]
            }
          },
          "route": {
            "type": "string"
          },
          "route_why": {
            "type": "string"
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "red_kind": {
                  "type": "string"
                }
              }
            }
          },
          "rewrite_tests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "limit": {
                  "type": "string"
                }
              }
            }
          },
          "removes_tests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "limit": {
                  "type": "string"
                }
              }
            }
          },
          "refactor": {
            "type": "object",
            "properties": {
              "declared": {
                "type": "boolean"
              },
              "why": {
                "type": "string"
              }
            }
          },
          "allowed_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "out_of_scope": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "glob": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                }
              }
            }
          },
          "structure": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "row": {
                  "type": "string"
                },
                "prescription": {
                  "type": "string"
                },
                "world": {
                  "type": "string"
                },
                "follows": {
                  "type": "boolean"
                },
                "deviation": {
                  "type": "string"
                }
              }
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "unit": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "receives": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "op": {
                  "type": "string"
                },
                "from": {
                  "type": "string"
                },
                "symbols": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "change": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "amended": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "object",
          "description": "json(shared:plan-reply-item.schema.json): 差し替えた項目の核の欄（lib/planmarks.py の CORE_KEYS）"
        }
      }
    }
  }
}
