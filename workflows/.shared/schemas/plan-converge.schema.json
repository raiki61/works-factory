{
  "description": "計画の往復の記録 plan-converge.json（書き手は line の src/rounds.py の fresh・record_pass・ask_again と、plan-review の作業の写し lib/converge.py）。外枠と plan の行は書き手が欄を足すので閉じない。往復の行（passes）は閉じ、書き手だけに欄を足すと読み手の照らしが落ちる（#845・#849・#851）",
  "type": "object",
  "required": [
    "passes"
  ],
  "properties": {
    "round": {
      "type": "integer"
    },
    "passes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pass": {
            "type": "integer"
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "faces": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "where": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                },
                "reach": {
                  "type": "string"
                }
              }
            }
          },
          "suggests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "handled": {
                  "type": "string"
                },
                "how": {
                  "type": "string"
                }
              }
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "unit_keys": {
                  "type": "array",
                  "items": {
                    "type": [
                      "integer",
                      "string"
                    ]
                  }
                },
                "kind": {
                  "type": "string"
                },
                "where": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                },
                "reach": {
                  "type": "string"
                },
                "no_add": {
                  "type": "string"
                }
              }
            }
          },
          "resolved": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "persists": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ]
          },
          "origins": {
            "type": "object",
            "patternProperties": {
              "^.+$": {
                "type": "string"
              }
            }
          },
          "flips": {"type": "object", "description": "採った前に閉じた block の裏返し {新しい block の key: 閉じた block の key}（lib/converge.py の FLIPS。持ち主の決め flip-asks）", "patternProperties": {"^.+$": {"type": "string"}}},
          "origins_claimed": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "origin": {
                  "type": "string"
                },
                "of": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          },
          "files": {
            "type": "object",
            "patternProperties": {
              "^.+$": {
                "type": "string"
              }
            }
          },
          "rejects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string"
                },
                "at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "拒んだ時刻（ISO 8601。前の版の控えから読み替えた行は null）"
                },
                "reason": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                }
              }
            }
          },
          "push": {
            "type": "object",
            "properties": {
              "answer": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            }
          },
          "face_units": {
            "type": "object",
            "patternProperties": {
              "^.+$": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "n": {
                  "type": "integer"
                },
                "id": {
                  "type": "string"
                },
                "unit_keys": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "hash": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "blocks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "reopened": {
                  "type": "boolean"
                },
                "row": {
                  "type": "object",
                  "description": "json(shared:plan-reply-item.schema.json): 受けた案の項目の行（決め手の欄を外した審査の形に、plan-fields.json の同じ番号の欄の行の works の欄〔lib/planmarks.py の KEYS〕を重ねた物。planmarks.joined）"
                },
                "hits": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "answer": {
                        "type": "string"
                      },
                      "why": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string"
                      },
                      "at": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "carried": {
                        "type": "integer",
                        "description": "前の往復の答えを引き継いだ時の、答えた往復の番号"
                      }
                    }
                  }
                },
                "refs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "file_notes": {
                  "type": "array",
                  "description": "下請けが読んだファイルの覚えと受け付けが測った sha256。フックの読んだ証拠 reads とは別物",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "description": "作業ツリーの根からの相対パス（POSIX の形）"
                      },
                      "sha256": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "受け付けが測った、読んだ時のファイルの中身の sha256（無い・読めないファイルは null）"
                      },
                      "learned": {
                        "type": "string"
                      },
                      "pass": {
                        "type": "integer",
                        "description": "覚えを書いた往復の番号"
                      }
                    }
                  }
                }
              }
            }
          },
          "synergy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capped": {
            "type": "boolean"
          },
          "means_drifts": {
            "type": "array",
            "description": "この往復で受けた頼みの解き方の食い違いの行（計画 means-answers の 3.2 の 6。鍵 (item, means, plan_quote) で後勝ちに積む）",
            "items": {"type": "object", "properties": {"item": {"type": "integer"}, "means": {"type": "string"}, "design_quote": {"type": "string"}, "plan_quote": {"type": "string"}, "why": {"type": "string"}, "recommend": {"type": "object", "properties": {"answer": {"type": "string"}, "note": {"type": "string"}, "why": {"type": "string"}}}}}
          },
          "means_departs": {
            "type": "array",
            "description": "この往復で受けた頼みの解き方の外れの推しの行（鍵 (item, means) で後勝ちに積む）",
            "items": {"type": "object", "properties": {"item": {"type": "integer"}, "means": {"type": "string"}, "why": {"type": "string"}, "recommend": {"type": "object", "properties": {"answer": {"type": "string"}, "note": {"type": "string"}, "why": {"type": "string"}}}}}
          }
        }
      }
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "open": {
      "type": "object",
      "properties": {
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "handled": {
                "type": "string"
              },
              "how": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "unit_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hash": {
            "type": "string"
          },
          "row": {
            "type": "object",
            "description": "json(shared:plan-reply-item.schema.json): 受けた案の項目の行（決め手の欄を外した審査の形に、plan-fields.json の同じ番号の欄の行の works の欄〔lib/planmarks.py の KEYS〕を重ねた物。planmarks.joined）"
          },
          "marks": {
            "type": "array",
            "description": "row の narrows の行と同じ並びの、外した決め手の欄（gatemarks.FIELDS と no_narrow）",
            "items": {
              "type": "object",
              "properties": {
                "decided_by": {
                  "type": "string"
                },
                "undecided_because": {
                  "type": "string"
                },
                "fences": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "world": {
                  "type": "string"
                },
                "recommend": {
                  "type": "object",
                  "properties": {
                    "answer": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    },
                    "why": {
                      "type": "string"
                    }
                  }
                },
                "no_narrow": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "precedent_checks": {
      "type": "object",
      "patternProperties": {
        "^.+$": {
          "type": "object",
          "properties": {
            "found": {
              "type": "boolean"
            },
            "quote": {
              "type": "string"
            },
            "round": {
              "type": "integer"
            },
            "pass": {
              "type": "integer"
            },
            "item": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
