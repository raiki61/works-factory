{
  "description": "案の直しの行（replan.json。書き手は修正案の block の形 replan の受け付けと事前審査の形 replan）{round, items: [lib/replan.py の TRIP_KEYS の行（欄は TRIP_KEYS と同じで、ほかの欄を置かない）]}。old・new は修正案の項目の行",
  "type": "object",
  "properties": {
    "round": {"type": "integer"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "units", "old", "new", "new_marks", "contract_changed", "widened"],
        "additionalProperties": false,
        "properties": {
          "item": {"type": "integer"},
          "units": {"type": "array", "items": {"type": ["string", "integer"]}},
          "old": {"type": ["object", "null"], "description": "json(shared:plan-reply-item.schema.json): 直す前の項目の行"},
          "new": {"type": ["object", "null"], "description": "json(shared:plan-reply-item.schema.json): 直した項目の行"},
          "new_marks": {"type": ["array", "null"], "description": "new の narrows の行と同じ並びの、外した決め手の欄（gatemarks.FIELDS と no_narrow。lib/replan.py の new_item が戻す）", "items": {"type": "object", "properties": {"decided_by": {"type": "string"}, "undecided_because": {"type": "string"}, "fences": {"type": "array", "items": {"type": "string"}}, "world": {"type": "string"}, "recommend": {"type": "object", "properties": {"answer": {"type": "string"}, "note": {"type": "string"}, "why": {"type": "string"}}}, "no_narrow": {"type": "string"}}}},
          "contract_changed": {"type": ["array", "null"], "description": "違う約束の欄の名（planmarks.contract_diff）", "items": {"type": "string"}},
          "widened": {"type": ["object", "null"], "description": "範囲を広げるだけの直しの足した・外した glob（planmarks.widened）。約束が変わらない・広げるだけでなければ null", "properties": {"allowed_paths": {"type": "array", "items": {"type": "string"}}, "out_of_scope": {"type": "array", "items": {"type": "string"}}}}
        }
      }
    }
  }
}
