{
  "description": "直した後の構造の実測の控え（structure-after.json。書き手は構造の目の block の after の段 B。読み口は lib/structmark.py の read_after）",
  "type": "object",
  "properties": {
    "status": {"type": "string", "enum": ["ok", "failed"]},
    "reason": {"type": "string"},
    "after": {
      "type": "object",
      "properties": {
        "status": {"type": "string"},
        "reason": {"type": "string"},
        "base_rev": {"type": "string"},
        "changed": {"type": "array", "items": {"type": "string"}},
        "tables": {"type": "array", "items": {"type": "string"}},
        "tables_changed": {"type": "array", "items": {"type": "string"}},
        "fence_up": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "concept": {"type": "string"},
              "what": {"type": "string"},
              "path": {"type": "string"},
              "before": {"type": "integer"},
              "after": {"type": "integer"}
            }
          }
        },
        "new_names": {"type": "array", "description": "差分が足した新しい名の行（structure の src/stage_b.py の summarize）", "items": {"type": "object", "properties": {"name": {"type": "string"}, "sites": {"type": "integer", "description": "名が現れる所の数"}}}},
        "dup_blocks_added": {"type": "integer"},
        "timing": {"type": "object", "patternProperties": {"^.+$": {"type": ["number", "string", "boolean", "null"]}}}
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {"type": "integer"},
          "row": {"type": ["string", "number", "null"]},
          "prescription": {"type": ["string", "number", "null"]},
          "world": {"type": ["string", "number", "null"]},
          "deviation": {"type": "string"}
        }
      }
    }
  }
}
