{
  "description": "依頼の行の配列か、それを findings の欄に持つオブジェクト（工場の依頼のファイルの形。findings のほかの欄はこの block は読まない）",
  "type": ["array", "object"],
  "items": {
    "type": "object",
    "required": ["where", "text"],
    "additionalProperties": false,
    "properties": {
      "where": {"type": "string"},
      "text": {"type": "string"},
      "mechanism": {"type": "string"},
      "measured": {"type": "string"},
      "false_positive_if": {"type": "string"}
    }
  },
  "required": ["findings"],
  "properties": {
    "theme": {"type": "string", "description": "テーマ（コードに落とす前の設計の問い）の文か、対象の根からの md のパス。設計の段の入口（docs/design/line.md の 3.3）"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["where", "text"],
    "additionalProperties": false,
        "properties": {
          "where": {"type": "string"},
          "text": {"type": "string"},
          "mechanism": {"type": "string"},
          "measured": {"type": "string"},
          "false_positive_if": {"type": "string"}
        }
      }
    }
  }
}
