{
  "description": "事前審査の 1 往復の控え（pass.json。書き手は事前審査の block の受け付け、読み手は往復の記録に往復の行を足す line の rounds.record_pass）。review は決め手の欄を外した事前審査の返答",
  "type": "object",
  "properties": {
    "pass": {
      "type": "integer"
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "unit_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hash": {
            "type": "string"
          },
          "row": {
            "type": "object",
            "description": "json(shared:plan-reply-item.schema.json): 受けた案の項目の行（決め手の欄を外した審査の形に、plan-fields.json の同じ番号の欄の行の works の欄〔lib/planmarks.py の KEYS〕を重ねた物。planmarks.joined）"
          },
          "marks": {
            "type": "array",
            "description": "row の narrows の行と同じ並びの、外した決め手の欄（gatemarks.FIELDS と no_narrow）",
            "items": {
              "type": "object",
              "properties": {
                "decided_by": {
                  "type": "string"
                },
                "undecided_because": {
                  "type": "string"
                },
                "fences": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "world": {
                  "type": "string"
                },
                "recommend": {
                  "type": "object",
                  "properties": {
                    "answer": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    },
                    "why": {
                      "type": "string"
                    }
                  }
                },
                "no_narrow": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "handled": {
            "type": "string"
          },
          "how": {
            "type": "string"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "description": "json(shared:plan-review-reply.schema.json): 決め手の欄を外した事前審査の返答"
    },
    "resolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "synergy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hits": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "carried": {
                "type": "integer",
                "description": "前の往復の答えを引き継いだ時の、答えた往復の番号"
              }
            }
          }
        }
      }
    },
    "origins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "of": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          }
        }
      }
    },
    "refs": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "push": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "answer": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "why": {
          "type": "string"
        }
      }
    },
    "files": {
      "type": "object",
      "patternProperties": {
        "^.+$": {
          "type": "string"
        }
      }
    },
    "rejects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "at": {
            "type": [
              "string",
              "null"
            ],
            "description": "拒んだ時刻（ISO 8601。前の版の控えから読み替えた行は null）"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "precedent_checks": {
      "type": "object",
      "patternProperties": {
        "^.+$": {
          "type": "object",
          "properties": {
            "found": {
              "type": "boolean"
            },
            "quote": {
              "type": "string"
            },
            "round": {
              "type": "integer"
            },
            "pass": {
              "type": "integer"
            },
            "item": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
