{
  "description": "独立設計の返答（今の r2-design の output_format の字のまま）。question_stands が真なら design と elements が設計、偽なら premise_invalid_reason（無ければ reason）が問いの立たない根拠",
  "type": "object",
  "additionalProperties": false,
  "required": ["question_stands", "reason", "design"],
  "properties": {
    "question_stands": {"type": "boolean"},
    "reason": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "premise_invalid_reason": {"type": "string"},
    "design": {"type": "string"},
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "adds", "removes"],
        "properties": {
          "id": {"type": "string", "pattern": "^D[0-9]+$"},
          "adds": {"type": "array", "items": {"type": "string"}},
          "removes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
