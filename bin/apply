#!/usr/bin/env python3
"""封じた差分を対象に当てる口: bin/apply <run-id> [--cwd <対象>] [--allow-delete] [--allow-stopped]。中身は bin/_lib/apply.py"""
import sys
from pathlib import Path

if sys.version_info < (3, 12):   # pyproject.toml の requires-python。古い Python は下の部品の読み込みで落ちる
    print("apply: Python 3.12 以上が要る", file=sys.stderr)
    sys.exit(2)

sys.dont_write_bytecode = True   # 入口の部品のフォルダに __pycache__ を作らない
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from bin._lib import apply  # noqa: E402

if __name__ == "__main__":
    sys.exit(apply.main(sys.argv[1:]))
