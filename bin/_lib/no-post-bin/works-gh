#!/usr/bin/env python3
"""読むだけの gh（bin/ の起動が Archon の子の PATH の頭に置く口。今の works では包みが印のある起動の全部に渡した。標準ライブラリだけ・Python 3.9 でも動く形）。

通すのは次の形だけで、ほかは本物の gh を起こさずに 1 行を出して終了コード 2:
- `pr list -R <OWNER/REPO> …`・`pr view <番号か枝> -R <OWNER/REPO> …`・`pr diff <番号か枝> -R <OWNER/REPO> …`・
  `issue view <番号> -R <OWNER/REPO> …`（`-R`・`--repo`・`--repo=` のどれか。対象の repo を名指しさせ、cwd の remote に頼らない）
- `repo view <OWNER/REPO> …`（gh の repo view は -R を持たないので、repo は位置の引数で名指しする）
- `api [--paginate] [--hostname <HOST>] repos/<OWNER>/<REPO>/pulls/<番号>/comments`（PR の行コメントを読む 1 つの形。gh api は
  -f・-F・--input の 1 つで黙って POST になるので、拒む旗を数えず、この形の字だけを通す。{owner} の埋めも通さない）
api の外の形では `-w`・`--web`（ブラウザを開く）を拒む。書く命令・`auth token` は表に無いので拒む。本物の gh は PATH の上の最初の gh（この口の置き場は飛ばす）。bin/ の起動の run では
それが利用者のログインを継ぐ口（bin/_lib/hostgh.py が書く）。本物の gh のパスを env に置かない・断りの文に出さない（役がその値で本物の gh を
打つ道を作らない。事故の柵で、堅い境ではない）。

今の works の包み（.shared/core/adapter.py）はこの口を PATH の頭に 2 つの名で置く（bin/ の起動も同じ置き場を PATH の頭に置く）: `works-gh`（役が素の名で呼ぶ名。sandbox の除外に当たる。
今の works の adapter の RO_GH）と `gh`
（`command gh`・`xargs gh`・`sh -c "gh …"` など、permissions.deny の `Bash(gh:*)` の前方一致をすり抜ける呼び方の受け皿）。
"""
import os
import re
import sys

ALLOWED = {("pr", "list"), ("pr", "view"), ("pr", "diff"), ("issue", "view"), ("repo", "view")}
REPO_RE = re.compile(r"(?:[A-Za-z0-9.-]+/)?[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\Z")
HOST_RE = re.compile(r"[A-Za-z0-9.-]+\Z")
API_RE = re.compile(r"repos/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pulls/[0-9]+/comments\Z")


def refuse(why):
    sys.stderr.write("works-gh: 通さない（読むだけの役に許すのは pr list・pr view・pr diff・issue view（-R 付き）と"
                     " repo view <OWNER/REPO>、api [--paginate] [--hostname <HOST>] repos/<OWNER>/<REPO>/pulls/<番号>/comments）"
                     f": {why}\n")
    return 2


def api_read(args):
    """api の後ろの引数が、--paginate と --hostname <HOST> を高々 1 つずつと、行コメントのパス 1 つだけか"""
    seen, path, i = set(), None, 0
    while i < len(args):
        a = args[i]
        if a == "--paginate" and a not in seen:
            seen.add(a)
        elif a == "--hostname" and a not in seen and i + 1 < len(args) and HOST_RE.match(args[i + 1]):
            seen.add(a)
            i += 1
        elif a.startswith("--hostname=") and "--hostname" not in seen and HOST_RE.match(a.split("=", 1)[1]):
            seen.add("--hostname")
        elif path is None and API_RE.match(a):
            path = a
        else:
            return False
        i += 1
    return path is not None


def repo_flag(args):
    for i, a in enumerate(args):
        if a in ("-R", "--repo") and i + 1 < len(args):
            return args[i + 1]
        if a.startswith("--repo=") or a.startswith("-R="):
            return a.split("=", 1)[1]
        if a.startswith("-R") and len(a) > 2:
            return a[2:]
    return None


def real_gh():
    """PATH の上の最初の gh（絶対パスの置き場だけ。この口の置き場——口自身・PATH の頭に置く gh——は飛ばす。取り違えると口と gh が
    互いを起こし続ける）。無ければ None"""
    here = os.path.dirname(os.path.realpath(__file__))
    for d in os.environ.get("PATH", "").split(os.pathsep):
        if not d or not os.path.isabs(d) or os.path.realpath(d) == here:
            continue
        c = os.path.join(d, "gh")
        if os.path.isfile(c) and os.access(c, os.X_OK) and os.path.dirname(os.path.realpath(c)) != here:
            return c
    return None


def form_error(argv):
    """通さない形なら理由の 1 行、通す形なら None"""
    if argv[:1] == ["api"]:
        return None if api_read(argv[1:]) else "gh api は行コメントを読む形だけ: " + " ".join(argv[1:])
    if len(argv) < 2 or (argv[0], argv[1]) not in ALLOWED:
        return " ".join(argv[:2]) or "引数が無い"
    rest = argv[2:]
    if any(a in ("-w", "--web") or a.startswith("--web=") for a in rest):
        return "--web は使わない"
    if argv[0] == "repo":
        pos = [a for a in rest if not a.startswith("-")]
        return None if pos and REPO_RE.match(pos[0]) else "gh repo view に <OWNER/REPO> が無い"
    repo = repo_flag(rest)
    return None if repo and REPO_RE.match(repo) else f"gh {argv[0]} {argv[1]} に -R <OWNER/REPO> が無い"


def main(argv):
    # 輪の断ち方は期限でなく形で: 口は本物の gh を起こす前に WORKS_FACTORY_GH_ACTIVE を立てる。本物の gh は口を呼ばないので、
    # これが立った env で口に入るのは、PATH の上の本物と取り違えた物が（置き場の外からでも）口へ回っている時だけ。その 2 度目で拒む
    if os.environ.get("WORKS_FACTORY_GH_ACTIVE"):
        return refuse("口が本物の gh の代わりに起こし直された（PATH の上の gh が口へ回っている）")
    why = form_error(argv)
    if why:
        return refuse(why)
    real = real_gh()
    if real is None:
        return refuse("本物の gh が PATH に無い")
    os.environ["WORKS_FACTORY_GH_ACTIVE"] = "1"
    os.execv(real, [real] + list(argv))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
